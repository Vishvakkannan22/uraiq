# Cloudflare Worker base URL. Leave unset and the app runs entirely on local
# mocks — every screen still works, nothing calls out.
VITE_API_URL=https://api.yourdomain.workers.dev

# Optional. Derived from VITE_API_URL (http->ws) when omitted; set it only if
# the Durable Object socket lives on a different host.
# VITE_WS_URL=wss://api.yourdomain.workers.dev
